# URL pública da aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sua_chave_publica
# Somente no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_sua_chave_privada

# Mercado Pago — credenciais de teste ou produção
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-
# Somente no servidor
MERCADO_PAGO_ACCESS_TOKEN=TEST-
MERCADO_PAGO_WEBHOOK_SECRET=

# Operação
STOCK_RESERVATION_MINUTES=30
CRON_SECRET=

# Opcional: necessário em deploys self-hosted com múltiplas instâncias
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
